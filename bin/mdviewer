import sys
from pathlib import Path

source = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(source if (source / "mdviewer" / "app.py").exists() else source / "share" / "mdviewer"))
from mdviewer.app import Application

raise SystemExit(Application().run(sys.argv))
