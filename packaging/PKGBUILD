pkgname=mdview
pkgver=0.1.0
pkgrel=1
pkgdesc='Small read-only Markdown viewer for GNOME'
arch=('any')
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'webkitgtk-6.0' 'python-markdown-it-py' 'python-pygments')
source=("mdview-$pkgver.tar.gz")
sha256sums=('SKIP') # Local source archive generated by make dist.

check() {
    cd "$srcdir/mdview-$pkgver"
    python -m unittest discover -s tests -v
}

package() {
    cd "$srcdir/mdview-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
