pkgname=mdviewer
pkgver=1.4.0
pkgrel=1
pkgdesc='Small read-only Markdown viewer for GNOME'
url='https://github.com/jschbe/mdviewer'
arch=('any')
license=('GPL-3.0-or-later')
options=('!debug') # Do not generate a separate debug package.
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'webkitgtk-6.0' 'python-markdown-it-py' 'python-pygments')
# Renamed application: avoid two commands/launchers and replace the old package.
conflicts=('mdview')
replaces=('mdview')
source=("mdviewer-$pkgver.tar.gz")
sha256sums=('SKIP') # Local source archive generated by make dist.

check() {
    cd "$srcdir/mdviewer-$pkgver"
    python -m unittest discover -s tests -v
}

package() {
    cd "$srcdir/mdviewer-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
