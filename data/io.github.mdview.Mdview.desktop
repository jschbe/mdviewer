[Desktop Entry]
Type=Application
Name=mdview
GenericName=Markdown Viewer
GenericName[de]=Markdown-Betrachter
GenericName[fr]=Visionneuse Markdown
GenericName[it]=Visualizzatore Markdown
GenericName[es]=Visor de Markdown
Comment=Read Markdown documents
Comment[de]=Markdown-Dokumente lesen
Comment[fr]=Lire des documents Markdown
Comment[it]=Leggi documenti Markdown
Comment[es]=Leer documentos Markdown
Exec=mdview %F
Icon=io.github.mdview.Mdview
Terminal=false
Categories=GNOME;GTK;Utility;Viewer;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
Keywords=Markdown;Read;Document;
Keywords[de]=Markdown;Lesen;Dokument;
Keywords[fr]=Markdown;Lire;Document;
Keywords[it]=Markdown;Leggere;Documento;
Keywords[es]=Markdown;Leer;Documento;
